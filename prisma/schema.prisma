// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// ข้อมูลบริษัท (Company Settings)
// ========================================
model Company {
  id            String   @id @default(cuid())
  nameTh        String   // ชื่อบริษัท (ภาษาไทย)
  nameEn        String   // ชื่อบริษัท (ภาษาอังกฤษ)
  addressTh     String   // ที่อยู่ (ภาษาไทย)
  addressEn     String?  // ที่อยู่ (ภาษาอังกฤษ)
  taxId         String   // เลขผู้เสียภาษี
  phones        String[] // เบอร์โทร
  email         String?  // E-mail
  logo          String?  // URL โลโก้บริษัท
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bankAccounts  BankAccount[]
}

model BankAccount {
  id            String   @id @default(cuid())
  bank          String   // ชื่อธนาคาร
  branch        String   // สาขา
  accountName   String   // ชื่อบัญชี
  accountNumber String   // เลขที่บัญชี
  accountType   String   // ประเภท (ออมทรัพย์/กระแสรายวัน)
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

// ========================================
// ผู้ใช้งาน (Users)
// ========================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          UserRole @default(STAFF)
  avatar        String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quotations    Quotation[]
  workOrders    WorkOrder[]
}

// สิทธิ์เข้าถึงเมนูต่อ role (แถวที่มี = อนุญาต) ADMIN เข้าได้ทุกเมนูเสมอจึงไม่เก็บ
model RolePermission {
  id        String   @id @default(cuid())
  role      UserRole
  menuKey   String
  createdAt DateTime @default(now())

  @@unique([role, menuKey])
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  ACCOUNTANT
}

// ========================================
// ข้อมูลลูกค้า (Customers)
// ========================================
model CustomerGroup {
  id               String   @id @default(cuid())
  groupName        String   // ชื่อกลุ่มลูกค้า (บริษัท)
  headOfficeAddress String  // ที่อยู่สำนักงานใหญ่
  taxId            String?  // เลขผู้เสียภาษี
  contactName      String?  // ชื่อผู้ติดต่อ
  contactPhone     String?  // เบอร์ติดต่อ
  contactEmail     String?  // อีเมลติดต่อ
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branches         CustomerBranch[]
  contacts         Contact[]
  quotations       Quotation[]
}

model CustomerBranch {
  id              String        @id @default(cuid())
  code            String        // รหัสสาขา (เช่น store036)
  name            String        // ชื่อสาขา
  address         String?       // ที่อยู่สาขา
  contactName     String?       // ชื่อผู้ติดต่อสาขา
  contactPhone    String?       // เบอร์ผู้ติดต่อสาขา
  customerGroupId String
  customerGroup   CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  quotations      Quotation[]
  workOrders      WorkOrder[]
}

// ========================================
// ผู้ติดต่อ (Contacts per Customer Group)
// ========================================
model Contact {
  id              String        @id @default(cuid())
  name            String        // ชื่อผู้ติดต่อ
  phone           String?       // เบอร์โทร
  email           String?       // อีเมล
  position        String?       // ตำแหน่ง
  customerGroupId String
  customerGroup   CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
}

// ========================================
// ข้อมูลทีมช่าง (Technician Teams)
// ========================================
model TechnicianTeam {
  id            String          @id @default(cuid())
  teamName      String          // ชื่อทีม
  leaderName    String          // ชื่อหัวหน้าช่าง
  leaderPhone   String?         // เบอร์โทรหัวหน้า
  leaderIdCard  String?         // เลขบัตรประชาชนหัวหน้า
  leaderAddress String?         // ที่อยู่หัวหน้า
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  members       TeamMember[]
  workOrders    WorkOrder[]
  purchaseOrders PurchaseOrder[]
}

model TeamMember {
  id              String         @id @default(cuid())
  name            String         // ชื่อสมาชิก
  phone           String?        // เบอร์โทร
  idCard          String?        // เลขบัตรประชาชน
  teamId          String
  team            TechnicianTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
}

// ========================================
// ใบเสนอราคา (Quotations)
// ========================================
model Quotation {
  id              String           @id @default(cuid())
  quotationNumber String           @unique // เลขที่ใบเสนอราคา (Npk-YYMMDD-XXX)
  revisionNumber  Int              @default(0) // revision number
  date            DateTime         // วันที่
  customerGroupId String
  customerGroup   CustomerGroup    @relation(fields: [customerGroupId], references: [id])
  branchId        String?
  branch          CustomerBranch?  @relation(fields: [branchId], references: [id])
  contactPerson   String?          // ผู้ติดต่อ
  contactPhone    String?          // เบอร์โทรผู้ติดต่อ
  address         String?          // ที่อยู่ (override จากลูกค้า, ไม่บังคับ)
  projectName     String?          // ชื่อโครงการ/งาน
  subtotal        Decimal          @default(0) @db.Decimal(12, 2) // ยอดรวมก่อน VAT
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal          @default(0) @db.Decimal(12, 2)
  vatPercent      Decimal          @default(7) @db.Decimal(5, 2)
  vatAmount       Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal          @default(0) @db.Decimal(12, 2) // ยอดรวมสุทธิ
  status          String           @default("DRAFT") // สถานะ (จาก WorkOrderStatusConfig, appliesTo = QUOTATION)
  notes           String?          // หมายเหตุ
  conditions      String?          // เงื่อนไข
  validDays       Int              @default(30) // จำนวนวันที่เสนอราคามีผล
  warranty        String?          // เงื่อนไขรับประกัน (legacy)
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items           QuotationItem[]
  workOrders      WorkOrder[]
  photos          QuotationPhoto[]
  purchaseOrders  PurchaseOrder[]
}

model QuotationItem {
  id            String    @id @default(cuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemOrder     Int       // ลำดับรายการ
  itemType      String    @default("ITEM") // HEADER or ITEM
  parentIndex   Int?      // parent header index for sub-items
  description   String    // รายละเอียด
  unit          String    @default("") // หน่วย
  quantity      Decimal   @default(0) @db.Decimal(10, 2) // จำนวน
  unitPrice     Decimal   @default(0) @db.Decimal(12, 2) // ราคาต่อหน่วย (unitPrice = materialPrice when no split)
  materialPrice Decimal   @default(0) @db.Decimal(12, 2) // ราคาวัสดุ
  labourPrice   Decimal   @default(0) @db.Decimal(12, 2) // ราคาค่าแรง
  amount        Decimal   @default(0) @db.Decimal(12, 2) // จำนวนเงิน
  isAdjustment  Boolean   @default(false) // true = รายการปรับแก้ (เพิ่ม/ลด), quantity ติดลบ = ลด
}

// ========================================
// ตั้งค่าสถานะ Work Order (Configurable)
// ========================================
model WorkOrderStatusConfig {
  id          String   @id @default(cuid())
  name        String   // ชื่อสถานะ (เช่น รอดำเนินการ, กำลังดำเนินการ)
  code        String   // CODE เช่น PENDING, IN_PROGRESS (ไม่ซ้ำภายในขอบเขต appliesTo เดียวกัน)
  appliesTo   String   @default("WO") // ใช้กับ: WO = ใบสั่งงาน, QUOTATION = ใบเสนอราคา
  color       String   @default("#64748B") // สีของสถานะ
  bgColor     String   @default("#F1F5F9") // สีพื้นหลัง badge
  sortOrder   Int      @default(0) // ลำดับการแสดงผล
  isDefault   Boolean  @default(false) // สถานะเริ่มต้น
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([code, appliesTo])
}

// ========================================
// ตอบรับทำงาน (Work Orders) - WO/PO
// ========================================
model WorkOrder {
  id              String           @id @default(cuid())
  woNumber        String           @unique // เลขที่ WO
  poNumber        String?          // เลข PO จากลูกค้า
  poDate          DateTime?        // วันที่ PO
  quotationId     String?
  quotation       Quotation?       @relation(fields: [quotationId], references: [id])
  branchId        String?
  branch          CustomerBranch?  @relation(fields: [branchId], references: [id])
  teamId          String?
  team            TechnicianTeam?  @relation(fields: [teamId], references: [id])
  teamName        String?          // ชื่อทีมช่าง (กรอกเอง)
  date            DateTime         // วันที่ WO
  startDate       DateTime?        // วันเริ่มงาน
  endDate         DateTime?        // วันสิ้นสุดงาน
  warrantyStartDate DateTime?      // วันเริ่มประกัน
  warrantyEndDate   DateTime?      // วันสิ้นสุดประกัน
  warrantyMonths    Int?           // ระยะเวลาประกัน (เดือน) เช่น 3, 6, 12
  retentionAmount   Decimal?       @db.Decimal(12, 2) // เงินประกันผลงาน ก่อน VAT (กรอกเอง)
  customerPO      String?          // เลข PO/WO ของลูกค้า (legacy)
  description     String?          // รายละเอียดงาน
  totalAmount     Decimal          @default(0) @db.Decimal(12, 2)
  status          String           @default("PENDING") // สถานะ (จาก WorkOrderStatusConfig)
  workflowType    String           @default("QUOTE_FIRST") // QUOTE_FIRST | WO_FIRST | WORK_FIRST - ลำดับการตอบรับงาน
  notes           String?
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  purchaseOrders  PurchaseOrder[]
  invoices        Invoice[]
  completedWork   CompletedWork?
}

// ========================================
// ใบสั่งซื้อให้ช่าง (Purchase Orders)
// ========================================
model PurchaseOrder {
  id              String           @id @default(cuid())
  poNumber        String           @unique // เลขที่ PO เช่น PO260319/Npk-001
  workOrderId     String?
  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id])
  quotationId     String?
  quotation       Quotation?       @relation(fields: [quotationId], references: [id])
  teamId          String?
  team            TechnicianTeam?  @relation(fields: [teamId], references: [id])
  date            DateTime
  startDate       DateTime?        // วันเริ่มงาน
  endDate         DateTime?        // วันสิ้นสุดงาน
  warrantyStartDate DateTime?      // วันเริ่มประกัน
  warrantyEndDate   DateTime?      // วันสิ้นสุดประกัน
  contractorQuoteUrl String?       // URL ไฟล์ใบเสนอราคาช่าง
  costType        String           @default("LABOUR") // ประเภทต้นทุน: LABOUR=ค่าแรง, MATERIAL=ค่าของ, OTHER=อื่นๆ
  costCategory    String?          // หมวดใบสำคัญจ่าย
  payeeName       String?          // ผู้รับเงิน (กรณีไม่ใช่ทีมช่าง เช่น ร้านค้า)
  warrantyMonths  Int?             // ระยะเวลาประกัน (เดือน)
  whtPercent      Decimal          @default(0) @db.Decimal(5, 2) // หัก ณ ที่จ่าย (%) เช่น 3
  whtAmount       Decimal          @default(0) @db.Decimal(12, 2)
  subtotal        Decimal          @default(0) @db.Decimal(12, 2) // ยอดรวมก่อนDiscount
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal          @default(0) @db.Decimal(12, 2)
  afterDiscount   Decimal          @default(0) @db.Decimal(12, 2)
  vatPercent      Decimal          @default(7) @db.Decimal(5, 2)
  vatAmount       Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal          @default(0) @db.Decimal(12, 2) // Grand Total
  status          POStatus         @default(DRAFT)
  notes           String?
  conditions      String?          // เงื่อนไขการชำระเงิน
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items           PurchaseOrderItem[]
  adjustments     POAdjustment[]
  installments    POInstallment[]
  paymentVouchers PaymentVoucher[]
}

// งวดจ่ายของ PO (ไม่จำกัดจำนวนงวด) — ใช้ดึงยอดตอนออกใบสำคัญจ่าย
model POInstallment {
  id              String         @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  seq             Int            // งวดที่
  percent         Decimal?       @db.Decimal(5, 2) // % ของยอด PO (ไม่บังคับ)
  dueDate         DateTime?      // วันครบกำหนดจ่าย
  amount          Decimal        @default(0) @db.Decimal(12, 2) // ยอดงวด
  retentionAmount Decimal        @default(0) @db.Decimal(12, 2) // ยอดหักค้างจ่าย/ประกัน (ถ้ามี)
  notes           String?
  createdAt       DateTime       @default(now())

  paymentVouchers PaymentVoucher[]

  @@unique([purchaseOrderId, seq])
}

enum POStatus {
  DRAFT
  APPROVED
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemOrder       Int           // ลำดับรายการ
  itemType        String        @default("ITEM") // HEADER or ITEM
  parentIndex     Int?          // parent header index
  description     String        // รายละเอียด
  unit            String        @default("") // หน่วย
  quantity        Decimal       @default(0) @db.Decimal(10, 2)
  materialPrice   Decimal       @default(0) @db.Decimal(12, 2) // ราคาวัสดุต่อหน่วย
  labourPrice     Decimal       @default(0) @db.Decimal(12, 2) // ราคาค่าแรงต่อหน่วย
  totalMaterial   Decimal       @default(0) @db.Decimal(12, 2) // qty * materialPrice
  totalLabour     Decimal       @default(0) @db.Decimal(12, 2) // qty * labourPrice
  amount          Decimal       @default(0) @db.Decimal(12, 2) // totalMaterial + totalLabour
  isLocked        Boolean       @default(false) // เมื่อบันทึกแล้ว lock ไม่ให้แก้ไข
  isAdjustment    Boolean       @default(false) // เป็นรายการเพิ่ม/ลดเพื่อแก้ไข
  createdAt       DateTime      @default(now())
}

// รายการปรับยอด PO (เพิ่ม/ลด) — ลบไม่ได้เพื่อ audit trail
model POAdjustment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  adjustmentType  String        // ADD หรือ DEDUCT
  description     String        // รายละเอียดงานเพิ่ม/ลด
  amount          Decimal       @db.Decimal(12, 2) // จำนวนเงิน (เป็นบวกเสมอ)
  createdBy       String?       // ชื่อคนที่ key
  createdAt       DateTime      @default(now())
}

// ========================================
// ใบแจ้งหนี้ (Invoices)
// ========================================
model Invoice {
  id              String         @id @default(cuid())
  invoiceNumber   String         @unique // เลขที่ใบแจ้งหนี้
  workOrderId     String?
  workOrder       WorkOrder?     @relation(fields: [workOrderId], references: [id])
  date            DateTime
  dueDate         DateTime       // วันครบกำหนดชำระ
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  vatPercent      Decimal        @default(7) @db.Decimal(5, 2)
  vatAmount       Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal        @default(0) @db.Decimal(12, 2)
  status          InvoiceStatus  @default(UNPAID)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  taxInvoice      TaxInvoice?
  receiptVoucher  ReceiptVoucher?
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

// ========================================
// ใบกำกับภาษี (Tax Invoices)
// ========================================
model TaxInvoice {
  id                String   @id @default(cuid())
  taxInvoiceNumber  String   @unique // เลขที่ใบกำกับภาษี
  invoiceId         String   @unique
  invoice           Invoice  @relation(fields: [invoiceId], references: [id])
  date              DateTime
  subtotal          Decimal  @default(0) @db.Decimal(12, 2)
  vatAmount         Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal  @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime @default(now())
}

// ========================================
// ใบสำคัญรับ (Receipt Vouchers)
// ========================================
model ReceiptVoucher {
  id              String        @id @default(cuid())
  voucherNumber   String        @unique // เลขที่ใบสำคัญรับ
  invoiceId       String?       @unique
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  date            DateTime
  amount          Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(TRANSFER)
  bankName        String?       // ชื่อธนาคาร
  chequeNumber    String?       // เลขที่เช็ค
  chequeDate      DateTime?     // วันที่เช็ค
  notes           String?
  createdAt       DateTime      @default(now())
}

// ========================================
// ใบสำคัญจ่าย (Payment Vouchers)
// ========================================
model PaymentVoucher {
  id              String        @id @default(cuid())
  voucherNumber   String        @unique // เลขที่ใบสำคัญจ่าย
  date            DateTime
  payeeName       String        // ชื่อผู้รับเงิน
  amount          Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(TRANSFER)
  bankName        String?
  chequeNumber    String?
  chequeDate      DateTime?
  description     String?       // รายละเอียดการจ่าย
  notes           String?
  category        String?       // หมวดใบสำคัญจ่าย (มาจาก PurchaseOrder.costCategory)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  installmentId   String?
  installment     POInstallment? @relation(fields: [installmentId], references: [id])
  createdAt       DateTime      @default(now())

  withholdingTax  WithholdingTax?
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHEQUE
}

// ========================================
// หนังสือรับรองหัก ณ ที่จ่าย (50 ทวิ)
// ========================================
model WithholdingTax {
  id                String         @id @default(cuid())
  whtNumber         String         @unique // เลขที่
  paymentVoucherId  String         @unique
  paymentVoucher    PaymentVoucher @relation(fields: [paymentVoucherId], references: [id])
  payeeName         String         // ชื่อผู้ถูกหัก
  payeeTaxId        String?        // เลขผู้เสียภาษี
  payeeAddress      String?        // ที่อยู่
  incomeType        String         // ประเภทเงินได้
  taxRate           Decimal        @db.Decimal(5, 2) // อัตราภาษี (%)
  incomeAmount      Decimal        @db.Decimal(12, 2) // จำนวนเงินที่จ่าย
  taxAmount         Decimal        @db.Decimal(12, 2) // ภาษีที่หัก
  date              DateTime
  notes             String?
  createdAt         DateTime       @default(now())
}

// ========================================
// รูปภาพก่อนทำงาน (Quotation Photos)
// ========================================
model QuotationPhoto {
  id            String    @id @default(cuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  fileName      String    // ชื่อไฟล์
  fileUrl       String    // URL ไฟล์
  fileSize      Int       @default(0) // ขนาดไฟล์ (bytes)
  caption       String?   // คำอธิบาย
  photoType     String    @default("BEFORE") // BEFORE = ก่อนทำงาน, AFTER = หลังทำงาน
  uploadedBy    String?   // ชื่อผู้อัพโหลด
  createdAt     DateTime  @default(now())
}

// ========================================
// งานเสร็จแล้ว (Completed Works)
// ========================================
model CompletedWork {
  id              String              @id @default(cuid())
  workOrderId     String              @unique
  workOrder       WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  completionDate  DateTime            @default(now())
  status          String              @default("COMPLETED") // COMPLETED, PENDING_PAYMENT, PAID
  notes           String?
  hasPhotos       Boolean             @default(false)
  hasWorkReceipt  Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  photos          CompletedWorkPhoto[]
  serviceItems    ServiceReportItem[]
}

model CompletedWorkPhoto {
  id              String        @id @default(cuid())
  completedWorkId String
  completedWork   CompletedWork @relation(fields: [completedWorkId], references: [id], onDelete: Cascade)
  fileName        String
  fileUrl         String
  fileSize        Int           @default(0)
  photoType       String        @default("WORK") // WORK = รูปงาน, RECEIPT = ใบรับงาน
  caption         String?
  createdAt       DateTime      @default(now())
}

model ServiceReportItem {
  id              String        @id @default(cuid())
  completedWorkId String
  completedWork   CompletedWork @relation(fields: [completedWorkId], references: [id], onDelete: Cascade)
  itemNo          Int           // ลำดับที่
  description     String        // รายการแจ้งแก้ไข/ปรับปรุง/ซ่อมแซม
  createdAt       DateTime      @default(now())
}
